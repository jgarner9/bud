# The worker needs the iCloud app-specific password and a separate random
# bearer token shared with the private Hermes profile. Use reference paths
# from your own private overlay.
BUD_CARDDAV_USER=op://vault/icloud-carddav/username
BUD_CARDDAV_PASSWORD=op://vault/icloud-carddav/password
BUD_CONTACTS_MCP_TOKEN=op://vault/contacts-mcp/token
