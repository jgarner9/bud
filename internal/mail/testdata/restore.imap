# Account.Restore: find the trash, look the message up by Message-ID, move
# it back where the log says it came from. Hand-written (see login_list.imap)
S: * OK [CAPABILITY IMAP4rev1 AUTH=PLAIN] IMAP4 service ready
C: a1 LOGIN "someone@example.com" "app-pass"
S: a1 OK [CAPABILITY IMAP4rev1 UIDPLUS MOVE] user logged in
C: a2 LIST "" "*"
S: * LIST (\HasNoChildren \Trash) "/" "Deleted Messages"
S: * LIST (\HasNoChildren) "/" "INBOX"
S: a2 OK LIST completed
C: a3 SELECT "Deleted Messages"
S: * 12 EXISTS
S: a3 OK [READ-WRITE] SELECT completed
C: a4 UID SEARCH HEADER Message-ID "<sale@example.net>"
S: * SEARCH 301
S: a4 OK SEARCH completed
C: a5 UID MOVE 301 "INBOX"
S: * 12 EXPUNGE
S: a5 OK MOVE completed
C: a6 LOGOUT
S: * BYE logging out
S: a6 OK LOGOUT completed
