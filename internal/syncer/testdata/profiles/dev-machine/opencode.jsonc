// Written by bud sync from the model registry and env fragments. Edits here are
// replaced on the next sync: change content/env or your overlay's env instead.
{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "plan": {
      "model": "go/kimi-k3.1-pro"
    },
    "private": {
      "description": "Private (P0) work: a local model, and only tools that never leave the house",
      "mode": "primary",
      "model": "qwen/qwen-35b",
      "permissions": [
        {
          "action": "webfetch",
          "effect": "deny",
          "resource": "*"
        },
        {
          "action": "websearch",
          "effect": "deny",
          "resource": "*"
        },
        {
          "action": "experimental_image_generate",
          "effect": "deny",
          "resource": "*"
        },
        {
          "action": "subagent",
          "effect": "deny",
          "resource": "*"
        },
        {
          "action": "context7_*",
          "effect": "deny",
          "resource": "*"
        },
        {
          "action": "exa_*",
          "effect": "deny",
          "resource": "*"
        },
        {
          "action": "linear_*",
          "effect": "deny",
          "resource": "*"
        },
        {
          "action": "playwright_*",
          "effect": "deny",
          "resource": "*"
        }
      ]
    }
  },
  "formatter": true,
  "instructions": [
    "/home/you/data/bud/content/current/AGENTS.md"
  ],
  "mcp": {
    "servers": {
      "cocoindex": {
        "command": [
          "uvx",
          "--from",
          "cocoindex-code==0.2.43",
          "ccc",
          "mcp"
        ],
        "type": "local"
      },
      "context7": {
        "oauth": false,
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "exa": {
        "headers": {
          "X-Bud-Privacy": "P1"
        },
        "oauth": false,
        "type": "remote",
        "url": "http://100.64.0.1:8790/exa/mcp"
      },
      "linear": {
        "headers": {
          "X-Bud-Privacy": "P1"
        },
        "oauth": false,
        "type": "remote",
        "url": "http://100.64.0.1:8790/linear/mcp"
      },
      "memory": {
        "headers": {
          "X-Bud-Privacy": "P1"
        },
        "oauth": false,
        "type": "remote",
        "url": "http://100.64.0.1:8790/memory/mcp"
      },
      "ops": {
        "headers": {
          "X-Bud-Privacy": "P1"
        },
        "oauth": false,
        "type": "remote",
        "url": "http://100.64.0.1:8790/ops/mcp"
      },
      "playwright": {
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@0.0.85"
        ],
        "type": "local"
      },
      "serena": {
        "command": [
          "uvx",
          "--from",
          "serena-agent==2.1.0",
          "serena",
          "start-mcp-server",
          "--context",
          "ide",
          "--project-from-cwd",
          "--open-web-dashboard",
          "false"
        ],
        "type": "local"
      }
    }
  },
  "model": "go/glm-5.3",
