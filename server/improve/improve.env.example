# What op run puts into bud improve's environment (Suite D125). The values
# are op:// references, never the secrets; the real file, with the Bud
# vault's paths, lives at ~/.config/bud-server/improve.env, mode 0600.
#
# A fine-grained GitHub token with Contents and Pull requests read and
# write on jgarner9/bud and the overlay, and nothing else. bud improve opens
# draft pull requests with it and reads their state; it never merges.
BUD_IMPROVE_GITHUB_TOKEN=op://vault/item/token
# Optional: the same strings the repo's leak check refuses, one regex per
# line, so a public proposal can't carry them
# BUD_LEAK_PATTERNS=op://vault/item/patterns
