{
  "marketplaces": {
    "bud-plugins": "https://github.com/jgarner9/bud-plugins.git"
  },
  "plugins": [
    "bud@bud-plugins",
    "bud-ide@bud-plugins"
  ],
  "servers": {
    "basic-memory": {
      "description": "Basic Memory: a self-hosted notes connector, plus the claude.ai memory mirror read at session start",
      "mcp": {
        "type": "http",
        "url": "${BASIC_MEMORY_URL}"
      },
      "vars": {
        "BASIC_MEMORY_URL": {
          "prompt": "URL of the notes connector's MCP endpoint",
          "secret": false
        }
      },
      "modes": ["full"],
      "connector": "Basic Memory",
      "desktop": true,
      "settings": {
        "permissions": {
          "allow": [
            "mcp__claude_ai_Basic_Memory__read_note",
            "mcp__basic-memory__read_note"
          ]
        }
      }
    },
    "cocoindex-code": {
      "description": "cocoindex-code: local semantic code search, find code by what it does (run ccc init once per project)",
      "mcp": {
        "type": "stdio",
        "command": "ccc",
        "args": ["mcp"]
      },
      "modes": ["full", "merge"],
      "requires": "ccc"
    },
    "code-index": {
      "description": "code-index: local symbol and text index for large repos (opt-in: it is added for every project)",
      "mcp": {
        "type": "stdio",
        "command": "mcp-index",
        "args": ["stdio"]
      },
      "modes": [],
      "requires": "mcp-index"
    },
    "context7": {
      "description": "Context7: current library and framework docs (hosted)",
      "mcp": {
        "type": "http",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
        }
      },
      "vars": {
        "CONTEXT7_API_KEY": {
          "prompt": "Context7 API key (blank = keyless, lower rate limit)",
          "secret": true
        }
      },
      "modes": ["full", "merge"],
      "connector": "Context7",
      "desktop": true,
      "settings": {
        "permissions": {
          "allow": [
            "mcp__context7__resolve-library-id",
            "mcp__context7__query-docs",
            "mcp__claude_ai_Context7__resolve-library-id",
            "mcp__claude_ai_Context7__query-docs"
          ]
        }
      }
    },
    "exa": {
      "description": "Exa: web search and fetch (hosted; stands in for WebSearch, which some third-party providers lack)",
      "mcp": {
        "type": "http",
        "url": "https://mcp.exa.ai/mcp",
        "headers": {
          "x-api-key": "${EXA_API_KEY}"
        }
      },
      "vars": {
        "EXA_API_KEY": {
          "prompt": "Exa API key (blank = keyless search and fetch at the free rate limit)",
          "secret": true
        }
      },
      "modes": ["full", "merge"],
      "connector": "Exa",
      "desktop": true,
      "settings": {
        "permissions": {
          "allow": [
            "mcp__exa__web_search_exa",
            "mcp__exa__web_fetch_exa",
            "mcp__claude_ai_Exa__web_search_exa",
            "mcp__claude_ai_Exa__web_fetch_exa"
          ]
        }
      }
    },
    "github": {
      "description": "GitHub's MCP server: pull requests, issues, code search (needs a personal access token; opt-in, since gh does the same from Bash)",
      "mcp": {
        "type": "http",
        "url": "https://api.githubcopilot.com/mcp",
        "headers": {
          "Authorization": "Bearer ${GITHUB_PAT:?}"
        }
      },
      "vars": {
        "GITHUB_PAT": {
          "prompt": "GitHub personal access token for the GitHub MCP server",
          "secret": true
        }
      },
      "modes": [],
      "connector": "GitHub"
    },
    "headroom": {
      "description": "Headroom: compresses large tool output and files, originals retrievable (local)",
      "mcp": {
        "type": "stdio",
        "command": "headroom",
        "args": ["mcp", "serve"],
        "env": {
          "HEADROOM_BEACON": "off"
        }
      },
      "modes": ["full", "merge"],
      "requires": "headroom"
    },
    "linear": {
      "description": "Linear: tasks and projects (hosted, OAuth; opt-in, since its ~80 tool names ride on every request)",
      "mcp": {
        "type": "http",
        "url": "https://mcp.linear.app/mcp"
      },
      "modes": [],
      "connector": "Linear",
      "desktop": true
    },
    "playwright": {
      "description": "Playwright: drives a real browser to check web pages (opt-in: it is added for every project)",
      "mcp": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "@playwright/mcp@0.0.83", "--headless"]
      },
      "modes": [],
      "requires": "npx"
    },
    "serena": {
      "description": "Serena: symbol-level code navigation backed by language servers (local)",
      "mcp": {
        "type": "stdio",
        "command": "serena",
        "args": ["start-mcp-server", "--context", "claude-code", "--project-from-cwd", "--open-web-dashboard", "false"]
      },
      "modes": ["full", "merge"],
      "requires": "serena",
      "settings": {
        "permissions": {
          "allow": [
            "mcp__serena__find_symbol",
            "mcp__serena__find_referencing_symbols",
            "mcp__serena__get_symbols_overview",
            "mcp__serena__search_for_pattern"
          ]
        }
      }
    }
  },
  "settings": {
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "model": "sonnet",
    "effortLevel": "medium",
    "modelSettings": {
      "claude-sonnet-5-5": {
        "effortLevel": "medium"
      }
    },
    "permissions": {
      "allow": [
        "Bash(rg *)",
        "Bash(repomap *)"
      ],
      "deny": [
        "Read(./.env)",
        "Read(./.env.*)",
        "Read(~/.ssh/id_*)",
        "Read(~/.aws/credentials)"
      ]
    }
  },
  "rules": {
    "core.md": {
      "marketplace": "bud-plugins/core.md"
    },
    "notes.md": {
      "file": "rules/notes.md",
      "server": "basic-memory"
    }
  },
  "account": {
    "marketplaces": ["jgarner9/bud-plugins"],
    "plugins": {
      "wanted": ["bud"],
      "unwanted": ["superpowers"]
    },
    "connectors": {
      "Basic Memory": {"on": true},
      "Claude Docs": {"on": false},
      "Context7": {"on": true},
      "Exa": {"on": true},
      "GitHub": {"on": false},
      "Linear": {"on": false},
      "Resend": {"on": false}
    },
    "instructions": "bud-plugins/core.md"
  },
  "cloud": {
    "script": "cloud/setup.sh"
  }
}
