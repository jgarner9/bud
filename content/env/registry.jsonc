// The provider and model registry (Suite D46, D58). bud sync renders every
// runtime's config from this file, so a model swap for a role is one edit here.
// The format is in docs/registry.md.
//
// This is the public, generic file. Hosts here are placeholders under .invalid,
// which never resolves: the private overlay's env/registry.jsonc replaces the
// local providers with the real addresses. An overlay entry replaces the entry
// of the same ID whole, so it restates every field, "local" included.
//
// Each role names a pool the router picks from (Suite D64). Facts about a
// model (inputs, caps, context, output, price) come from its provider's model
// list: `bud registry refresh content/env/registry.jsonc go` rechecks them and
// --write rewrites them (Suite D69). grade, allowance (Go Plus's included
// dollars a month) and retention (days the provider keeps requests) are kept
// by hand from https://opencode.ai/docs/go, last checked 2026-11-15.
{
  "version": 1,

  "providers": {
    // OpenCode Go Plus (Suite D11), the one cloud key for the manager and coding
    "go": {
      "api": "openai",
      "endpoint": "https://opencode.ai/inference/go/openai/v1",
      "key": "{env:OPENCODE_GO_API_KEY}"
    },
    // llama.cpp on the Qwen box (Suite D25), woken on demand (D26)
    "qwen": {
      "api": "openai",
      "endpoint": "http://qwen.invalid:8080/v1",
      "local": true
    },
    // the small FIM model, a second llama-server on the Qwen box (Suite D32, D55)
    "qwen-fim": {
      "api": "openai",
      "endpoint": "http://qwen.invalid:8081/v1",
      "local": true
    },
    // embeddings on the always-on home server, so memory never waits for the Qwen box (Suite D52)
    "embed": {
      "api": "openai",
      "endpoint": "http://home.invalid:8082/v1",
      "local": true
    },
    // the classifier on the always-on home server, so routing never waits for the Qwen box (Suite D67)
    "classify": {
      "api": "openai",
      "endpoint": "http://home.invalid:8083/v1",
      "local": true
    }
  },

  "models": {
    // Local models: the only ones that may see P0 (Suite D23). Names on local
    // providers are llama-server --alias values, which bud sets, so the GGUF
    // behind them can change without touching this file. Their facts are
    // declared by hand.
    // qwen-35b is Qwen3.6-35B-A3B, the 35B MoE with about 3B parameters active
    // per token (confirmed by Jason, 2026-11-16)
    "qwen-35b": { "provider": "qwen", "name": "qwen-35b", "privacy": ["P0", "P1", "P2"], "cost": "C0",
      "grade": "mid", "inputs": ["text", "image"], "caps": ["tools", "reasoning", "json"], "context": 32768, "retention": 0 },
    "qwen-fim": { "provider": "qwen-fim", "name": "coder-fim", "privacy": ["P0", "P1", "P2"], "cost": "C0",
      "grade": "light", "inputs": ["text"], "caps": ["fim"], "context": 8192, "retention": 0 },
    // a small dense model that scores fixed answers rather than writing them (Suite D67)
    "gemma-4-e4b": { "provider": "classify", "name": "gemma-4-e4b", "privacy": ["P0", "P1", "P2"], "cost": "C0",
      "grade": "light", "inputs": ["text"], "caps": ["json"], "context": 32768, "retention": 0 },
    "qwen3-embedding-0.6b": { "provider": "embed", "name": "qwen3-embedding-0.6b", "privacy": ["P0", "P1", "P2"], "cost": "C0",
      "inputs": ["text"], "caps": ["embed"], "dims": 1024, "retention": 0 },

    // OpenCode Go Plus, all zero-retention (Suite D65). top
    "kimi-k3.1-pro": { "provider": "go", "name": "kimi-k3.1-pro", "privacy": ["P1", "P2"], "cost": "C1",
      "grade": "top", "allowance": 60, "retention": 0, "inputs": ["text", "image", "video"], "caps": ["tools", "reasoning", "json"], "context": 1048576, "output": 1048576, "price": { "in": 2, "out": 10 } },
    "glm-5.3": { "provider": "go", "name": "glm-5.3", "privacy": ["P1", "P2"], "cost": "C1",
      "grade": "top", "allowance": 120, "retention": 0, "inputs": ["text"], "caps": ["tools", "reasoning", "json"], "context": 1000000, "output": 131072, "price": { "in": 1.4, "out": 4.4 } },
    "qwen3.8-max": { "provider": "go", "name": "qwen3.8-max", "privacy": ["P1", "P2"], "cost": "C1",
      "grade": "top", "allowance": 60, "retention": 0, "inputs": ["text", "image", "video"], "caps": ["tools", "reasoning", "json"], "context": 1000000, "output": 131072, "price": { "in": 2, "out": 6 } },
    // the price is half off until 2026-11-30
    "gemini-4-argon": { "provider": "go", "name": "gemini-4-argon", "privacy": ["P1", "P2"], "cost": "C1",
      "grade": "top", "allowance": 120, "retention": 0, "inputs": ["text", "image", "video", "audio", "pdf"], "caps": ["tools", "reasoning", "json"], "context": 1048576, "output": 65536, "price": { "in": 2, "out": 10 } },

    // mid
    "kimi-k2.7-code": { "provider": "go", "name": "kimi-k2.7-code", "privacy": ["P1", "P2"], "cost": "C1",
      "grade": "mid", "allowance": 180, "retention": 0, "inputs": ["text", "image", "video"], "caps": ["tools", "reasoning", "json"], "context": 262144, "output": 262144, "price": { "in": 0.95, "out": 4 } },
    "glm-5.2": { "provider": "go", "name": "glm-5.2", "privacy": ["P1", "P2"], "cost": "C1",
      "grade": "mid", "allowance": 180, "retention": 0, "inputs": ["text"], "caps": ["tools", "reasoning", "json"], "context": 1000000, "output": 131072, "price": { "in": 1.4, "out": 4.4 } },
    "minimax-m3": { "provider": "go", "name": "minimax-m3", "privacy": ["P1", "P2"], "cost": "C1",
      "grade": "mid", "allowance": 180, "retention": 0, "inputs": ["text", "image", "video"], "caps": ["tools", "reasoning"], "context": 1000000, "output": 131072, "price": { "in": 0.3, "out": 1.2 } },
    "qwen3.7-plus": { "provider": "go", "name": "qwen3.7-plus", "privacy": ["P1", "P2"], "cost": "C1",
      "grade": "mid", "allowance": 180, "retention": 0, "inputs": ["text", "image", "video"], "caps": ["tools", "reasoning"], "context": 1000000, "output": 65536, "price": { "in": 0.4, "out": 1.6 } },
    "mimo-v2.6-pro": { "provider": "go", "name": "mimo-v2.6-pro", "privacy": ["P1", "P2"], "cost": "C1",
      "grade": "mid", "allowance": 60, "retention": 0, "inputs": ["text", "image", "video", "audio"], "caps": ["tools", "reasoning"], "context": 1048576, "output": 131072, "price": { "in": 0.435, "out": 0.87 } },

    // light
    "glm-5.3-flash": { "provider": "go", "name": "glm-5.3-flash", "privacy": ["P1", "P2"], "cost": "C1",
      "grade": "light", "allowance": 180, "retention": 0, "inputs": ["text", "image", "video"], "caps": ["tools", "reasoning", "json"], "context": 1000000, "output": 131072, "price": { "in": 0.15, "out": 0.5 } },
    "qwen3.8-flash": { "provider": "go", "name": "qwen3.8-flash", "privacy": ["P1", "P2"], "cost": "C1",
      "grade": "light", "allowance": 90, "retention": 0, "inputs": ["text", "image", "video"], "caps": ["tools", "reasoning", "json"], "context": 1000000, "output": 131072, "price": { "in": 0.15, "out": 0.47 } },
    "minimax-m3.1-flash": { "provider": "go", "name": "minimax-m3.1-flash", "privacy": ["P1", "P2"], "cost": "C1",
      "grade": "light", "allowance": 80, "retention": 0, "inputs": ["text", "image", "video"], "caps": ["tools", "reasoning"], "context": 1000000, "output": 512000, "price": { "in": 0.15, "out": 0.6 } },
    // the cheapest, for the autocomplete fallback (Suite D38)
    "mimo-v2.6-flash": { "provider": "go", "name": "mimo-v2.6-flash", "privacy": ["P1", "P2"], "cost": "C1",
      "grade": "light", "allowance": 120, "retention": 0, "inputs": ["text", "image", "video", "audio"], "caps": ["tools", "reasoning"], "context": 1048576, "output": 131072, "price": { "in": 0.14, "out": 0.28 } },
  },

  // Pools are in preference order; the router filters each by privacy, needs,
  // context, health and allowance left, then ranks by grade (Suite D64)
  "roles": {
    // Qwen first: routine chores stay on C0 (Suite D24)
    "manager": { "needs": ["tools"], "pool": ["qwen-35b", "glm-5.3-flash", "qwen3.8-flash", "mimo-v2.6-pro", "glm-5.3", "kimi-k3.1-pro"] },
    "coding": { "needs": ["tools"], "pool": ["glm-5.3", "kimi-k2.7-code", "minimax-m3", "glm-5.2", "glm-5.3-flash", "minimax-m3.1-flash", "qwen-35b"] },
    "planning": { "needs": ["reasoning"], "pool": ["kimi-k3.1-pro", "glm-5.3", "qwen3.8-max", "gemini-4-argon", "qwen3.7-plus", "qwen-35b"] },
    // the home server's classifier, then the Qwen box when it's awake (Suite D67)
    "classifier": { "needs": ["json"], "pool": ["gemma-4-e4b", "qwen-35b"] },
    // Qwen first, a Go model when the box is off, never on P0 paths (Suite D32, D38)
    "fim": { "pool": ["qwen-fim", "mimo-v2.6-flash"] },
    "embedding": { "needs": ["embed"], "pool": ["qwen3-embedding-0.6b"] },
    // what any role uses once its own pool is exhausted; local, so it is P0-safe
    "fallback": { "pool": ["qwen-35b"] },
    "curator": { "needs": ["json"], "pool": ["qwen-35b"] },
    // qwen-35b is the only one that may see a P0 image
    "vision": { "needs": ["image"], "pool": ["qwen-35b", "qwen3.8-flash", "glm-5.3-flash", "kimi-k3.1-pro", "gemini-4-argon"] },
  },

  // Rules that raise a request's privacy tier, applied by the router to
  // every message before it picks a model (Suite D23, D112). They only
  // raise: a request already more private stays as it is. Personal rules
  // (names, places, accounts) go in the overlay's registry.jsonc.
  "privacy_rules": {
    // start a message with #private to keep the whole conversation local
    "marker": { "match": "(?i)^\\s*#private\\b", "tier": "P0" },
    // a pasted private key is a secret (Suite D23)
    "private-key": { "match": "-----BEGIN [A-Z ]*PRIVATE KEY-----", "tier": "P0" },

    // personal data, each pattern broad and its validator strict (Suite
    // D118): a card number (starting 3 to 6, as the card networks' do) has
    // to pass the Luhn checksum, an IBAN mod-97, an SSN the ranges ever
    // issued, and a phone number E.164's length or North America's
    // numbering plan. Names, places and topics that should stay local go in
    // your overlay's registry.jsonc, never here
    "pii-card": { "match": "\\b[3-6]\\d(?:[ -]?\\d){11,17}\\b", "tier": "P0", "validate": "luhn" },
    "pii-iban": { "match": "\\b[A-Z]{2}\\d{2}(?: ?[A-Z0-9]{4}){2,7}(?: ?[A-Z0-9]{1,4})?\\b", "tier": "P0", "validate": "iban" },
    "pii-ssn": { "match": "\\b\\d{3}-\\d{2}-\\d{4}\\b", "tier": "P0", "validate": "ssn" },
    "pii-phone": { "match": "\\+\\d[\\d .-]{6,18}\\d|\\(?\\b\\d{3}\\)?[ .-]\\d{3}[ .-]\\d{4}\\b", "tier": "P0", "validate": "phone" },

    // secrets: a pasted key or token is a secret (Suite D23, D118)
    // BEGIN secret rules: generated by go run ./scripts/gen-secret-rules from gitleaks'
    // config/gitleaks.toml at 5f6ec56cfa6f8c67648d863582c7ae2f206d5c1c (MIT, Copyright (c) 2019
    // Zachary Rice). Edit the list in scripts/gen-secret-rules, not these lines
    "secret-1password-secret-key": { "match": "\\bA3-[A-Z0-9]{6}-(?:(?:[A-Z0-9]{11})|(?:[A-Z0-9]{6}-[A-Z0-9]{5}))-[A-Z0-9]{5}-[A-Z0-9]{5}-[A-Z0-9]{5}\\b", "tier": "P0", "entropy": 3.8, "keywords": ["a3-"] },
    "secret-1password-service-account-token": { "match": "ops_eyJ[a-zA-Z0-9+/]{250,}={0,3}", "tier": "P0", "entropy": 4, "keywords": ["ops_"] },
    "secret-age-secret-key": { "match": "AGE-SECRET-KEY-1[QPZRY9X8GF2TVDW0S3JN54KHCE6MUA7L]{58}", "tier": "P0", "keywords": ["age-secret-key-1"] },
    "secret-anthropic-admin-api-key": { "match": "\\b(sk-ant-admin01-[a-zA-Z0-9_\\-]{93}AA)(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "tier": "P0", "keywords": ["sk-ant-admin01"] },
    "secret-anthropic-api-key": { "match": "\\b(sk-ant-api03-[a-zA-Z0-9_\\-]{93}AA)(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "tier": "P0", "keywords": ["sk-ant-api03"] },
    "secret-aws-access-token": { "match": "\\b((?:A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z2-7]{16})\\b", "tier": "P0", "entropy": 3, "keywords": ["a3t", "akia", "asia", "abia", "acca"] },
    "secret-digitalocean-pat": { "match": "\\b(dop_v1_[a-f0-9]{64})(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "tier": "P0", "entropy": 3, "keywords": ["dop_v1_"] },
    "secret-doppler-api-token": { "match": "dp\\.pt\\.(?i)[a-z0-9]{43}", "tier": "P0", "entropy": 2, "keywords": ["dp.pt."] },
    "secret-gcp-api-key": { "match": "\\b(AIza[\\w-]{35})(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "tier": "P0", "entropy": 4, "keywords": ["aiza"] },
    "secret-github-app-token": { "match": "(?:ghu|ghs)_[0-9a-zA-Z]{36}", "tier": "P0", "entropy": 3, "keywords": ["ghu_", "ghs_"] },
    "secret-github-fine-grained-pat": { "match": "github_pat_\\w{82}", "tier": "P0", "entropy": 3, "keywords": ["github_pat_"] },
    "secret-github-oauth": { "match": "gho_[0-9a-zA-Z]{36}", "tier": "P0", "entropy": 3, "keywords": ["gho_"] },
    "secret-github-pat": { "match": "ghp_[0-9a-zA-Z]{36}", "tier": "P0", "entropy": 3, "keywords": ["ghp_"] },
    "secret-github-refresh-token": { "match": "ghr_[0-9a-zA-Z]{36}", "tier": "P0", "entropy": 3, "keywords": ["ghr_"] },
    "secret-gitlab-pat": { "match": "glpat-[\\w-]{20}", "tier": "P0", "entropy": 3, "keywords": ["glpat-"] },
    "secret-hashicorp-tf-api-token": { "match": "(?i)[a-z0-9]{14}\\.(?-i:atlasv1)\\.[a-z0-9\\-_=]{60,70}", "tier": "P0", "entropy": 3.5, "keywords": ["atlasv1"] },
    "secret-huggingface-access-token": { "match": "\\b(hf_(?i:[a-z]{34}))(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "tier": "P0", "entropy": 2, "keywords": ["hf_"] },
    "secret-jwt": { "match": "\\b(ey[a-zA-Z0-9]{17,}\\.ey[a-zA-Z0-9\\/\\\\_-]{17,}\\.(?:[a-zA-Z0-9\\/\\\\_-]{10,}={0,2})?)(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "tier": "P0", "entropy": 3, "keywords": ["ey"] },
    "secret-linear-api-key": { "match": "lin_api_(?i)[a-z0-9]{40}", "tier": "P0", "entropy": 2, "keywords": ["lin_api_"] },
    "secret-npm-access-token": { "match": "(?i)\\b(npm_[a-z0-9]{36})(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "tier": "P0", "entropy": 2, "keywords": ["npm_"] },
    "secret-openai-api-key": { "match": "\\b(sk-(?:proj|svcacct|admin)-(?:[A-Za-z0-9_-]{74}|[A-Za-z0-9_-]{58})T3BlbkFJ(?:[A-Za-z0-9_-]{74}|[A-Za-z0-9_-]{58})\\b|sk-[a-zA-Z0-9]{20}T3BlbkFJ[a-zA-Z0-9]{20})(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "tier": "P0", "entropy": 3, "keywords": ["t3blbkfj"] },
    "secret-perplexity-api-key": { "match": "\\b(pplx-[a-zA-Z0-9]{48})(?:[\\x60'\"\\s;]|\\\\[nr]|$|\\b)", "tier": "P0", "entropy": 4, "keywords": ["pplx-"] },
    "secret-postman-api-token": { "match": "\\b(PMAK-(?i)[a-f0-9]{24}\\-[a-f0-9]{34})(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "tier": "P0", "entropy": 3, "keywords": ["pmak-"] },
    "secret-pypi-upload-token": { "match": "pypi-AgEIcHlwaS5vcmc[\\w-]{50,1000}", "tier": "P0", "entropy": 3, "keywords": ["pypi-ageichlwas5vcmc"] },
    "secret-sendgrid-api-token": { "match": "\\b(SG\\.(?i)[a-z0-9=_\\-\\.]{66})(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "tier": "P0", "entropy": 2, "keywords": ["sg."] },
    "secret-shopify-access-token": { "match": "shpat_[a-fA-F0-9]{32}", "tier": "P0", "entropy": 2, "keywords": ["shpat_"] },
    "secret-slack-app-token": { "match": "(?i)xapp-\\d-[A-Z0-9]+-\\d+-[a-z0-9]+", "tier": "P0", "entropy": 2, "keywords": ["xapp"] },
    "secret-slack-bot-token": { "match": "xoxb-[0-9]{10,13}-[0-9]{10,13}[a-zA-Z0-9-]*", "tier": "P0", "entropy": 3, "keywords": ["xoxb"] },
    "secret-slack-user-token": { "match": "xox[pe](?:-[0-9]{10,13}){3}-[a-zA-Z0-9-]{28,34}", "tier": "P0", "entropy": 2, "keywords": ["xoxp-", "xoxe-"] },
    "secret-slack-webhook-url": { "match": "(?:https?://)?hooks.slack.com/(?:services|workflows|triggers)/[A-Za-z0-9+/]{43,56}", "tier": "P0", "keywords": ["hooks.slack.com"] },
    "secret-stripe-access-token": { "match": "\\b((?:sk|rk)_(?:test|live|prod)_[a-zA-Z0-9]{10,99})(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "tier": "P0", "entropy": 2, "keywords": ["sk_test", "sk_live", "sk_prod", "rk_test", "rk_live", "rk_prod"] },
    "secret-vault-service-token": { "match": "\\b((?:hvs\\.[\\w-]{90,120}|s\\.(?i:[a-z0-9]{24})))(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "tier": "P0", "entropy": 3.5, "keywords": ["hvs.", "s."] },
    // END secret rules
  },
}
