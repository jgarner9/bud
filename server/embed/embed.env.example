# Copy to ~/.config/bud-server/embed.env (mode 0600) and fill in the values
# scripts/build-embed-server.sh printed. The unit checks both files against
# these digests before it starts the server.
BUD_EMBED_SERVER_SHA256=replace-with-the-printed-sha256
BUD_EMBED_MODEL_SHA256=06507c7b42688469c4e7298b0a1e16deff06caf291cf0a5b278c308249c3e439
# CPU threads for the server; the number of physical cores is a good start,
# fewer if Hermes and the router feel slow while memory embeds
BUD_EMBED_THREADS=4
