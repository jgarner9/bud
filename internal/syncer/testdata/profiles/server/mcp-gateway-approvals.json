{
  "servers": {
    "calendar": {
      "tools": {
        "create_*": "ask",
        "delete_*": "ask",
        "list_*": "allow",
        "move_*": "ask"
      },
      "when": [
        {
          "tool": "create_event",
          "effect": "allow",
          "args": {
            "attendees": {
              "empty": true
            }
          }
        }
      ]
    },
    "linear": {
      "tools": {
        "extract_images": "allow",
        "get_*": "allow",
        "list_*": "allow",
        "search_*": "allow"
      }
    },
    "mail": {
      "tools": {
        "cleanup_*": "allow",
        "list_*": "allow",
        "move_to_trash": "allow",
        "read_*": "allow",
        "reply_*": "ask",
        "restore_*": "allow",
        "search_*": "allow",
        "send_*": "ask"
      }
    },
    "memory": {
      "tools": {
        "memory_search": "allow",
        "memory_stage": "allow"
      }
    }
  }
}
