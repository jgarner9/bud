[Unit]
Description=Bud working memory service
After=network.target

[Service]
Type=simple
UMask=0077
RuntimeDirectory=bud-memory
RuntimeDirectoryMode=0700
StateDirectory=bud-memory
StateDirectoryMode=0700
Environment=BUD_MEMORY_SOCKET=%t/bud-memory/memory.sock
Environment=BUD_MEMORY_DATABASE=%S/bud-memory/memory.sqlite
EnvironmentFile=%h/.config/bud-server/op-service-account.env
ExecStart=/usr/bin/env op run --env-file %h/.config/bud/memory.env -- /usr/bin/python3 %h/.local/lib/bud/memory/main.py
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target
