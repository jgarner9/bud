# The memory service's reviewer token, which op run puts into bud
# memory-review's environment (Suite D113). The value is an op:// reference,
# never the token; the real file, with the Bud vault's path, lives at
# ~/.config/bud-server/memory-review.env. The token's BUD_MEMORY_CLIENTS
# policy is tiers P0, P1, P2 and actions staged, approve, discard (and
# search, if it already had it).
BUD_MEMORY_TOKEN_REVIEWER=op://vault/item/reviewer
