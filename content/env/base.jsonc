// The action tiers for commands as OpenCode permission rules (Suite D10, D16,
// D41, D43). OpenCode applies the last rule that matches, so the broad rule
// comes first and the exceptions follow. Each command has a bare form and a
// "with arguments" form, since "go test *" doesn't match a bare "go test".
// Your own run-alone additions go in your overlay's env, which applies after
// this file (Suite D43).
{
  "permissions": [
    // anything not listed asks in the editor
    { "action": "shell", "resource": "*", "effect": "ask" },

    // do alone: tests, builds, linters, read-only git, metrics, and the D41 tools
    { "action": "shell", "resource": "go test", "effect": "allow" },
    { "action": "shell", "resource": "go test *", "effect": "allow" },
    { "action": "shell", "resource": "go vet", "effect": "allow" },
    { "action": "shell", "resource": "go vet *", "effect": "allow" },
    { "action": "shell", "resource": "go build", "effect": "allow" },
    { "action": "shell", "resource": "go build *", "effect": "allow" },
    { "action": "shell", "resource": "gofmt", "effect": "allow" },
    { "action": "shell", "resource": "gofmt *", "effect": "allow" },
    { "action": "shell", "resource": "go fmt", "effect": "allow" },
    { "action": "shell", "resource": "go fmt *", "effect": "allow" },
    { "action": "shell", "resource": "just check", "effect": "allow" },
    { "action": "shell", "resource": "just check *", "effect": "allow" },
    { "action": "shell", "resource": "just test", "effect": "allow" },
    { "action": "shell", "resource": "just test *", "effect": "allow" },
    { "action": "shell", "resource": "just lint", "effect": "allow" },
    { "action": "shell", "resource": "just lint *", "effect": "allow" },
    { "action": "shell", "resource": "just fmt", "effect": "allow" },
    { "action": "shell", "resource": "just fmt *", "effect": "allow" },
    { "action": "shell", "resource": "make", "effect": "allow" },
    { "action": "shell", "resource": "make *", "effect": "allow" },
    { "action": "shell", "resource": "shellcheck", "effect": "allow" },
    { "action": "shell", "resource": "shellcheck *", "effect": "allow" },
    { "action": "shell", "resource": "stylua", "effect": "allow" },
    { "action": "shell", "resource": "stylua *", "effect": "allow" },
    { "action": "shell", "resource": "selene", "effect": "allow" },
    { "action": "shell", "resource": "selene *", "effect": "allow" },
    { "action": "shell", "resource": "golangci-lint", "effect": "allow" },
    { "action": "shell", "resource": "golangci-lint *", "effect": "allow" },
    { "action": "shell", "resource": "git status", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git blame", "effect": "allow" },
    { "action": "shell", "resource": "git blame *", "effect": "allow" },
    { "action": "shell", "resource": "scc", "effect": "allow" },
    { "action": "shell", "resource": "scc *", "effect": "allow" },
    { "action": "shell", "resource": "tokei", "effect": "allow" },
    { "action": "shell", "resource": "tokei *", "effect": "allow" },
    { "action": "shell", "resource": "hyperfine", "effect": "allow" },
    { "action": "shell", "resource": "hyperfine *", "effect": "allow" },
    { "action": "shell", "resource": "bud run", "effect": "allow" },
    { "action": "shell", "resource": "bud run *", "effect": "allow" },
    { "action": "shell", "resource": "docker build", "effect": "allow" },
    { "action": "shell", "resource": "docker build *", "effect": "allow" },
    { "action": "shell", "resource": "docker compose up", "effect": "allow" },
    { "action": "shell", "resource": "docker compose up *", "effect": "allow" },
    { "action": "shell", "resource": "docker compose down", "effect": "allow" },
    { "action": "shell", "resource": "docker compose down *", "effect": "allow" },
    { "action": "shell", "resource": "docker compose ps", "effect": "allow" },
    { "action": "shell", "resource": "docker compose ps *", "effect": "allow" },
    { "action": "shell", "resource": "docker compose logs", "effect": "allow" },
    { "action": "shell", "resource": "docker compose logs *", "effect": "allow" },
    { "action": "shell", "resource": "docker ps", "effect": "allow" },
    { "action": "shell", "resource": "docker ps *", "effect": "allow" },
    { "action": "shell", "resource": "docker logs", "effect": "allow" },
    { "action": "shell", "resource": "docker logs *", "effect": "allow" },
    { "action": "shell", "resource": "docker exec", "effect": "allow" },
    { "action": "shell", "resource": "docker exec *", "effect": "allow" },
    { "action": "shell", "resource": "npm test", "effect": "allow" },
    { "action": "shell", "resource": "npm test *", "effect": "allow" },
    { "action": "shell", "resource": "npm run", "effect": "allow" },
    { "action": "shell", "resource": "npm run *", "effect": "allow" },
    { "action": "shell", "resource": "npm ci", "effect": "allow" },
    { "action": "shell", "resource": "npm ci *", "effect": "allow" },

    // ask, even though the tool runs alone otherwise: commits (D41), pushes,
    // removing docker data (D43) and adding npm packages, which run install scripts (D43)
    { "action": "shell", "resource": "git commit", "effect": "ask" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git push", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "docker system prune", "effect": "ask" },
    { "action": "shell", "resource": "docker system prune *", "effect": "ask" },
    { "action": "shell", "resource": "docker image prune", "effect": "ask" },
    { "action": "shell", "resource": "docker image prune *", "effect": "ask" },
    { "action": "shell", "resource": "docker volume prune", "effect": "ask" },
    { "action": "shell", "resource": "docker volume prune *", "effect": "ask" },
    { "action": "shell", "resource": "docker container prune", "effect": "ask" },
    { "action": "shell", "resource": "docker container prune *", "effect": "ask" },
    { "action": "shell", "resource": "docker volume rm", "effect": "ask" },
    { "action": "shell", "resource": "docker volume rm *", "effect": "ask" },
    { "action": "shell", "resource": "docker image rm", "effect": "ask" },
    { "action": "shell", "resource": "docker image rm *", "effect": "ask" },
    { "action": "shell", "resource": "docker rmi", "effect": "ask" },
    { "action": "shell", "resource": "docker rmi *", "effect": "ask" },
    { "action": "shell", "resource": "npm install", "effect": "ask" },
    { "action": "shell", "resource": "npm install *", "effect": "ask" },
    { "action": "shell", "resource": "npm i", "effect": "ask" },
    { "action": "shell", "resource": "npm i *", "effect": "ask" },
    { "action": "shell", "resource": "npm add", "effect": "ask" },
    { "action": "shell", "resource": "npm add *", "effect": "ask" },
    { "action": "shell", "resource": "docker * --privileged*", "effect": "ask" },

    // never: the agent doesn't touch the secrets store; values reach tools only
    // through op run at launch (Suite D7)
    { "action": "shell", "resource": "op", "effect": "deny" },
    { "action": "shell", "resource": "op *", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "ask" },
  ],
}
