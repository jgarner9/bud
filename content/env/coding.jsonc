// For devices where code is written (the dev-machine profile): OpenCode
// formats the files its edit tools change with the built-in formatter for
// each language it finds installed, and asks before reading or editing
// anything outside the open project, except bud's synced content, which the
// skills and instructions point into. Applies after base.jsonc.
{
  "formatter": true,
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.local/share/bud/*", "effect": "allow" },
    { "action": "read", "resource": "~/.local/share/bud/*", "effect": "allow" },
  ],
}
