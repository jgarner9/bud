# The credentials op run puts into the calendar server's environment (Suite
# D7, D82). Each value is an op:// reference, never the value; the real
# file, with the Bud vault's paths, lives in the overlay. The password is an
# iCloud app-specific password (appleid.apple.com, Sign-In and Security),
# made for Bud alone so it can be revoked on its own.
BUD_CALDAV_USER=op://vault/icloud-caldav/username
BUD_CALDAV_PASSWORD=op://vault/icloud-caldav/password
