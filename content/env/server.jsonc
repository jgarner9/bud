// For the home server (the server profile): the planning OpenCode (Suite
// D49) and Hermes, the manager (D48). Applies after base.jsonc.
//
// The tools follow the tool map (Suite D72-D78, D85). On the server, search
// uses Exa natively, with EXA_API_KEY from op run: the planning OpenCode's
// websearch, and Hermes's web tools, which search through SearXNG (D85) and
// extract through Exa, with the keyless fallback off so a search never
// quietly goes to another provider (D77). Linear goes through the MCP
// gateway (D75), and GitHub is reached from here only, at GitHub's hosted
// MCP server with a fine-grained PAT from op run (D76, D94). The Bud ops MCP
// (D83) is on this machine's loopback. The calendar (D82) goes through the
// gateway, which lets only P0 sessions use it; it is Hermes's alone, so the
// planning OpenCode is denied it. Mail (D106) is the same. Your overlay's env sets bud.gateway and
// bud.mcp.memory.url.
{
  "websearch": { "provider": "exa" },
  "permissions": [
    { "action": "experimental_image_generate", "resource": "*", "effect": "deny" },

    // Linear: reads run alone, creating or changing anything asks (D75)
    { "action": "linear_*", "resource": "*", "effect": "ask" },
    { "action": "linear_get_*", "resource": "*", "effect": "allow" },
    { "action": "linear_list_*", "resource": "*", "effect": "allow" },
    { "action": "linear_search_*", "resource": "*", "effect": "allow" },
    { "action": "linear_extract_images", "resource": "*", "effect": "allow" },

    // GitHub: reads and opening PRs run alone, the rest (merges among them) asks (D76)
    { "action": "github_*", "resource": "*", "effect": "ask" },
    { "action": "github_get_*", "resource": "*", "effect": "allow" },
    { "action": "github_list_*", "resource": "*", "effect": "allow" },
    { "action": "github_search_*", "resource": "*", "effect": "allow" },
    { "action": "github_create_pull_request", "resource": "*", "effect": "allow" },

    // the calendar and mail are the manager's only (D82, D106)
    { "action": "calendar_*", "resource": "*", "effect": "deny" },
    { "action": "mail_*", "resource": "*", "effect": "deny" },

    { "action": "context7_*", "resource": "*", "effect": "allow" },
    { "action": "memory_*", "resource": "*", "effect": "allow" },
    { "action": "ops_*", "resource": "*", "effect": "allow" },
  ],
  "bud": {
    "privacy": "P1",
    "mcp": {
      // approval tiers the gateway enforces (D97, D103): reads run alone,
      // anything else asks, and a tool no key names asks too. Keys carry the
      // runtime's <name>_ prefix; bud sync strips it for the gateway
      "linear": {
        "gateway": true,
        "privacy": ["P1", "P2"],
        "approval": { "tools": { "linear_get_*": "allow", "linear_list_*": "allow", "linear_search_*": "allow", "linear_extract_images": "allow" } },
      },
      // GitHub's hosted server, so there is no binary to install or keep up
      // to date; the fine-grained PAT is sent as a header. A PAT works without
      // a Copilot licence. With the variable unset, Hermes doesn't connect it
      "github": {
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": { "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}" },
        "privacy": ["P1", "P2"],
      },
      "context7": { "url": "https://mcp.context7.com/mcp", "privacy": ["P1", "P2"] },
      "memory": { "privacy": ["P0", "P1", "P2"] },
      // the Bud ops MCP (D83), bud mcp-ops on this machine's loopback;
      // read-only, and its answers never leave the house, so P0 may use it
      "ops": { "url": "http://127.0.0.1:8792/mcp", "privacy": ["P0", "P1", "P2"] },
      // bud calendar-mcp, server/calendar-mcp/ (D82)
      // listing runs alone; creating, moving and deleting events ask. An
      // event with no attendees runs alone (Suite D116), since it sends no
      // invites; one with attendees, or a field the gateway can't read, asks
      "calendar": {
        "gateway": true,
        "privacy": ["P0"],
        "approval": {
          "tools": { "calendar_list_*": "allow", "calendar_create_*": "ask", "calendar_move_*": "ask", "calendar_delete_*": "ask" },
          "when": [{ "tool": "calendar_create_event", "effect": "allow", "args": { "attendees": { "empty": true } } }],
        },
      },
      // bud mail-mcp, server/mail-mcp/ (D106): reading, moving to Deleted
      // Messages and restoring run alone (D36); every send and reply asks
      // (D31), and its prompt shows the whole message (D107)
      "mail": {
        "gateway": true,
        "privacy": ["P0"],
        "approval": { "tools": { "mail_list_*": "allow", "mail_search_*": "allow", "mail_read_*": "allow", "mail_move_to_trash": "allow", "mail_restore_*": "allow", "mail_cleanup_*": "allow", "mail_send_*": "ask", "mail_reply_*": "ask" } },
      },
    },
    // Hermes's terminal runs in its Docker sandbox, which can't reach the
    // host, the vault or bud's files, so a command runs alone unless it
    // reaches out of the sandbox (D114): pushes, remote shells and copies,
    // and publishing. The coding devices keep base.jsonc's shell rules.
    // bud hermes-gate also reads a command through env, sudo, sh -c, eval,
    // $( ) and a path such as /usr/bin/git, so those don't dodge a rule.
    // Your overlay's rules come after these, and the last match wins
    "sandbox_shell": [
      { "resource": "*", "effect": "allow" },
      { "resource": "git push", "effect": "ask" },
      { "resource": "git push *", "effect": "ask" },
      { "resource": "ssh", "effect": "ask" },
      { "resource": "ssh *", "effect": "ask" },
      { "resource": "scp", "effect": "ask" },
      { "resource": "scp *", "effect": "ask" },
      { "resource": "sftp", "effect": "ask" },
      { "resource": "sftp *", "effect": "ask" },
      { "resource": "rsync", "effect": "ask" },
      { "resource": "rsync *", "effect": "ask" },
      { "resource": "npm publish", "effect": "ask" },
      { "resource": "npm publish *", "effect": "ask" },
      { "resource": "pnpm publish", "effect": "ask" },
      { "resource": "pnpm publish *", "effect": "ask" },
      { "resource": "yarn publish", "effect": "ask" },
      { "resource": "yarn publish *", "effect": "ask" },
      { "resource": "cargo publish", "effect": "ask" },
      { "resource": "cargo publish *", "effect": "ask" },
      { "resource": "twine upload", "effect": "ask" },
      { "resource": "twine upload *", "effect": "ask" },
      { "resource": "docker push", "effect": "ask" },
      { "resource": "docker push *", "effect": "ask" },
      { "resource": "gh release", "effect": "ask" },
      { "resource": "gh release *", "effect": "ask" },
      // never: the agent doesn't touch the secrets store (D7)
      { "resource": "op", "effect": "deny" },
      { "resource": "op *", "effect": "deny" },
    ],
    // Hermes's own tools by action tier (D10, D48), read by bud hermes-gate
    // before every call; terminal commands follow sandbox_shell above.
    // allow runs alone, ask waits for Jason's approval, deny is refused. A
    // tool not listed asks
    "tiers": {
      "*": "ask",
      // reading, searching and planning
      "web_search": "allow",
      "web_extract": "allow",
      "read_file": "allow",
      "search_files": "allow",
      "skills_list": "allow",
      "skill_view": "allow",
      "session_search": "allow",
      "todo_list": "allow",
      "clarify": "allow",
      "vision_analyze": "allow",
      // inside the Docker sandbox (D48)
      "write_file": "allow",
      "patch": "allow",
      "process_manage": "allow",
      "execute_code": "allow",
      "delegate_task": "allow",
      // Hermes's own memory is off (JGA-313): it remembers through Bud
      // memory (mcp__memory__*), one store for every runtime
      "memory": "deny",
      "skill_manage": "allow",
      // creating or changing a job asks first (tool map); one tool does both
      // reading and writing jobs, so it asks unless tiers_when below lets
      // its listing through
      "cronjob_manage": "ask",
      // one tool both reads pages and submits forms, so it asks; the vault
      // stays off (D10)
      "browser_exec": "ask",
      "browser_cdp": "ask",
      "browser_dialog": "ask",
      "browser_vault": "deny",
      "computer_use": "deny",
      // MCP tools run alone here: the gateway asks for Linear, calendar
      // and mail writes, and Hermes itself before any GitHub tool that isn't
      // marked read-only (below)
      "mcp__*": "allow",
    },
    // when rules over the tiers above (Suite D116): a rule whose argument
    // conditions hold decides over the tool's tier, the strictest winning,
    // and nothing loosens a deny. Listing cron jobs only reads, so it runs
    // alone; any other action, or an action the gate can't read, still asks
    "tiers_when": [
      { "tool": "cronjob_manage", "effect": "allow", "args": { "action": { "equals": "list" } } },
    ],
    "hermes": {
      // the built-in toolsets per platform, from the tool map. Off: tts,
      // computer_use, image_gen, video, x_search, kanban, discord, feishu,
      // debugging, and memory (JGA-313: Bud memory's memory_search and
      // memory_stage instead, which the overlay reaches through the gateway). clarify is left out where nobody can answer (the API and cron)
      "platform_toolsets": {
        "cli": ["terminal", "file", "code_execution", "web", "browser", "session_search", "skills", "cronjob", "delegation", "todo", "clarify", "vision"],
        "signal": ["terminal", "file", "code_execution", "web", "browser", "session_search", "skills", "cronjob", "delegation", "todo", "clarify", "vision"],
        "api_server": ["terminal", "file", "code_execution", "web", "browser", "session_search", "skills", "cronjob", "delegation", "todo", "vision"],
        "cron": ["terminal", "file", "code_execution", "web", "browser", "session_search", "skills", "cronjob", "delegation", "todo", "vision"],
      },
      "web": { "backend": "exa", "search_backend": "searxng", "extract_backend": "exa", "keyless_fallback": false },
      // Hermes asks before any tool on these that isn't marked read-only.
      // Linear, the calendar and mail aren't listed: the gateway asks for
      // their writes, bound to the exact arguments, so bud sync renders them
      // trusted and each write asks once (D115). GitHub doesn't go through
      // the gateway, so Hermes keeps asking for it
      "mcp_servers": {
        "github": { "trust": "untrusted" },
      },
    },
  },
}
