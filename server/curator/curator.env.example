# What op run puts into bud curator's environment (Suite D123). The value
# is an op:// reference, never the secret; the real file, with the Bud
# vault's path, lives at ~/.config/bud-server/curator.env, mode 0600.
#
# The memory service's curator token. Its policy in the service's clients
# list allows the export action only, on tiers P1 and P2.
BUD_MEMORY_TOKEN_CURATOR=op://vault/item/curator
