# The credentials op run puts into the mail server's environment (Suite D7,
# D106). Each value is an op:// reference, never the value; the real file,
# with the Bud vault's paths, lives in the overlay. The password is an
# iCloud app-specific password (appleid.apple.com, Sign-In and Security),
# made for Bud's mail alone so it can be revoked on its own. BUD_MAIL_FROM
# is the iCloud address mail goes out from; leave it out to turn sending off.
BUD_MAIL_USER=op://vault/icloud-mail/username
BUD_MAIL_PASSWORD=op://vault/icloud-mail/password
BUD_MAIL_FROM=op://vault/icloud-mail/from
