# Copy to ~/.config/bud/memory.env and replace every value.
# Use an op:// reference to a 1Password item containing the JSON policy.
BUD_MEMORY_CLIENTS=op://example-vault/example-item/credential
# Path and SHA-256 of the installed pinned sqlite-vec extension.
BUD_MEMORY_VEC_EXTENSION=/absolute/path/to/vec0.so
BUD_MEMORY_VEC_SHA256=replace-with-sha256
