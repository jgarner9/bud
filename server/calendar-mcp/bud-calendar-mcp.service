# The home server's calendar MCP server (Suite D82), as a systemd user unit:
#
#   cp bud-calendar-mcp.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now bud-calendar-mcp
#
# op run resolves the iCloud username and app-specific password in the env
# file through the Bud vault's service account, whose token the first
# EnvironmentFile holds. They reach the server's environment and never
# touch disk. It listens on loopback only; the MCP gateway is what Hermes
# reaches, and the gateway lets only P0 sessions through.
[Unit]
Description=Bud calendar MCP server (CalDAV)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=%h/.config/bud-server/op-service-account.env
ExecStart=/usr/bin/env op run --env-file=%h/.config/bud-server/calendar-mcp.env -- %h/.local/bin/bud calendar-mcp --listen 127.0.0.1:8791
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
