# The planning OpenCode's Basic auth password (username opencode), which the
# IDE sends from its ai.planning.password_file. Generate one with
# openssl rand -base64 32 and put the same value in both places. This file is
# /home/bud-planning/.config/bud-server/planning-opencode.env, mode 0600,
# owned by bud-planning. It holds the password itself, not a reference: it's
# this server's own password, not a vault secret.
OPENCODE_PASSWORD=
